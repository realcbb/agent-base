# 复制为 .env 后填入真实值；.env 不入包/不提交。或运行 python scripts/gen_demo_env.py 自动生成 demo .env。

# ---- 网关 ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
# 租户密钥表：tenant=key 逗号分隔。demo 租户 demo-dev 的 key 必须替换为随机值。
PROJECT_KEYS=demo-dev=REPLACE_WITH_RANDOM_KEY
GATEWAY_RATE_LIMIT_PER_MIN=120
# 网关状态后端：memory（默认，进程内，网关只能单副本）| redis
# （生产高可用：events/runs/限流外置，多副本共享，限流全局口径）。
# 连接取 GATEWAY_REDIS_HOST/PORT，未设回退 SERVICE_REDIS_*。
GATEWAY_STATE_BACKEND=memory
# 按终端用户限流（0=关）：开启后单个工号独立分桶，不连累同租户
GATEWAY_RATE_LIMIT_PER_USER_PER_MIN=0
# 终端身份断言校验（0=关）：开启后带 X-End-User-Id 的请求须附
# X-End-User-Ts＋X-End-User-Proof（HMAC_SHA256(项目密钥,
# "{工号}.{时间戳}")），业务后端/SDK 须同步开启
GATEWAY_REQUIRE_USER_PROOF=0
# 同会话消息排队等待上限（秒），超限回 409 SESSION_BUSY
GATEWAY_SESSION_QUEUE_TIMEOUT_SECS=180
# usage 逐调用流水库：生产给全量 URL，与服务存储同 MySQL 实例即可
# AGENT_BASE_USAGE_URL=mysql+pymysql://用户:密码@主机:3306/agentbase?charset=utf8mb4
# 未给 AGENT_BASE_USAGE_URL 时从 SERVICE_DB_URL 推导同库；下面这行
# 文件路径仅本地开发/演示可用（映射 sqlite），生产不得使用：
AGENT_BASE_USAGE_DB=data/usage.db
# 确认台账＋审计账：确认卡历史与审计的数据源，生产必须可用。
# 未给时从 SERVICE_DB_URL 推导同库（生产即与服务存储同 MySQL 实例）：
# AGENT_BASE_LEDGER_URL=mysql+pymysql://用户:密码@主机:3306/agentbase?charset=utf8mb4

# ---- AgentScope Service（原生） ----
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8100
SERVICE_URL=http://127.0.0.1:8100
# 存储：sql（默认）| redis。sql 时连接串见 SERVICE_DB_URL——demo 为
# SQLite 文件，生产改 MySQL：
# SERVICE_DB_URL=mysql+aiomysql://用户:密码@主机:3306/库名?charset=utf8mb4
SERVICE_STORAGE=sql
SERVICE_DB_URL=sqlite+aiosqlite:///./data/service.db
# 消息总线：memory（默认，进程内，服务单进程时用）| redis。
# 与存储独立选择；生产组合 = sql(MySQL) 存储 + redis 总线。
# 不设置时沿旧行为：存储为 redis 则总线 redis、否则 memory。
# SERVICE_BUS=redis
SERVICE_REDIS_HOST=127.0.0.1
SERVICE_REDIS_PORT=6379
# 工作区后端：local（默认，本机目录）| k8s（内网 K8s 集群生产形态：
# 每工作区一个 Pod＋PVC，服务可多副本）。k8s 时下列 SERVICE_K8S_* 生效；
# 服务进程须有集群身份（in-cluster 或 kubeconfig），且其账号在工作区
# 命名空间有管理 Pod/PVC 的 RBAC 权限。
SERVICE_WORKSPACE=local
SERVICE_WORKSPACE_DIR=./data/workspaces
SERVICE_K8S_NAMESPACE=agentscope
SERVICE_K8S_IMAGE=python:3.11-slim
SERVICE_K8S_STORAGE_CLASS=
SERVICE_K8S_STORAGE_SIZE=1Gi
SERVICE_K8S_IMAGE_PULL_SECRETS=

# ---- MCP demo ----
MCP_HOST=127.0.0.1
MCP_PORT=8200
# 网关按注册表 url_env 读此变量（service 装配不再读）
MCP_URL=http://127.0.0.1:8200/mcp
MCP_DEMO_NOTES_FILE=./data/notes.txt

# ---- 模型 ----
# 留空 BASE_URL/MODEL 即走 mock 模型（确定性演示）。填了则走 OpenAI 兼容端点。
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
